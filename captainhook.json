{
  "pre-commit": {
    "enabled": true,
    "actions": [
      {
        "action": "php vendor\\bin\\php-cs-fixer fix src --rules=@PSR12 --diff"
      },
      {
        "action": "git add ."
      }
    ]
  },
  "pre-push": {
    "enabled": true,
    "actions": [
      {
        "action": "php vendor\\bin\\phpstan analyse src"
      },
      {
        "action": "php vendor\\bin\\phpunit"
      }
    ]
  }
}
